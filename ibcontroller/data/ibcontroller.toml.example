# ibcontroller configuration file. Keys below belong under the [ibcontroller] table.
#
# Precedence (highest to lowest):
#   1. Environment variables (override everything)
#   2. This config file
#   3. Built-in defaults
#
# Credentials are environment-variable-only and must never appear in this file --
# ibcontroller.config.load_config() refuses to start if it finds one here. They use a
# single pair regardless of trading_mode below (the mode says which account to
# authenticate as; it does not select different credential variables):
#   IBC_USERID     / IBC_PASSWORD
# Each also accepts a _FILE-suffixed variant (e.g. IBC_PASSWORD_FILE=/run/secrets/pass)
# that reads the value from a file instead -- Docker/Compose secrets, not the env var itself.
#
# A .env file also works, via `ibcontroller run --dotenv <path>` -- it only fills in
# environment variables that aren't already set (python-dotenv, override=False), so it's a
# convenience for populating the environment layer above, not a fourth layer of its own.
#
# This file is copied here by `ibcontroller init` (or automatically by `ibcontroller run`
# the first time it's missing) with every key commented out below -- as shipped, it
# changes nothing versus built-in defaults. Only IBC_USERID/IBC_PASSWORD
# are actually required to run -- everything else here has a safe default or is
# auto-detected from the real install.
#
# The file has one table per concern:
#   [ibcontroller]  ibcontroller's own settings (env prefix IBC_). The schema is
#                   closed: an unknown key is rejected at startup with a clean error.
#   [ibkr]          values for IBKR's own settings and pop-ups, by name (env
#                   prefix IBKR_). A value given as an environment variable wins
#                   over the file.
#   [[setting]]     a Global Configuration setting the bundled catalog does not
#                   know, described by you.
#   [[dialog]]      a pop-up the bundled catalog does not know, described by you.
# Keys at the top of the file, outside any table, and unknown tables are rejected.

[ibcontroller]

# Socket/instance name (env: IBC_INSTANCE). Optional: when unset,
# defaults to "{program}-{trading_mode}" (e.g. "gateway-paper").
# instance = "dev"

# Program to run "gateway" or "tws" (env: IBC_PROGRAM)
# Default "gateway"
# program = "gateway"

# Installed TWS/Gateway version, e.g. "10.50" (env: IBC_TWS_VERSION). Omit this
# key (the default) to auto-detect it from tws_path -- if more than one version is
# installed, the greatest is picked (optionally narrowed by tws_channel below); set this
# explicitly to pin one instead.
# tws_version = "10.50"

# Which update channel to prefer when auto-detecting tws_version -- "stable" or "latest"
# (env: IBC_TWS_CHANNEL), as labeled by the install itself
# (.install4j/i4jparams.conf). Ignored when tws_version is set explicitly.
# Default "stable"
# tws_channel = "stable"

# Override the install path launcher.py would otherwise infer (env: IBC_TWS_PATH)
# Default "~/Applications" (macOS), "~/Jts" (Linux)
# tws_path = "~/Jts"
# tws_path = "~/Applications"

# Where TWS/Gateway itself stores its settings, deliberately NOT the same as tws_path
# (the install location). None defaults, {instance}={program}-{trading_mode}
# ie, ~/Jts/gateway-live
# tws_settings_path =

# TWS/Gateway is "live" or "paper" -- defaults to "paper" (the safe, non-monetary mode)
# when unset (env: IBC_TRADING_MODE)
# Default "paper"
# trading_mode = "paper"

# Where ibcontroller's own log and trace files live (env: IBC_LOG_DIR).
# Optional: when unset, defaults to the platformdirs user-log dir (or
# $IBC_APP_DIR/log in docker mode). Every instance's files (log, trace,
# gateway stdout) land flat in this one directory.
# log_dir = "~/.local/state/ibcontroller/log"
# log_dir = "~/Library/Logs/ibcontroller"
# log_dir = ""

# Verbosity of ibcontroller's own log and the Java agent log: "debug", "info",
# "warning" or "error", in any letter case; anything else is a config error.
# "debug" adds the human-readable arrival line for every agent message. Independent
# of trace_enabled below (env: IBC_LOG_LEVEL)
# Default "info"
# log_level = "info"

# Where ibcontroller's own log and Gateway/TWS's own console output go: "std"
# (console only) or "file" (only, under log_dir) -- exclusive, not both. Doesn't
# affect the wire trace above, which stays file-only regardless of this setting.
# (env: IBC_LOG_SINK)
# Default "std"
# log_sink = "std"

# Rotation for log/trace files -- only respected when log_sink = "file". ON BY
# DEFAULT (10 MiB x 5 backups); commenting these out does NOT disable it. Set
# log_max_bytes = 0 to disable (unbounded files). Java agent log active file
# becomes ibcontroller-java-agent-{instance}.log.0 once rotation is on -- see
# "Logging" in README.md.
# log_max_bytes: rotate at this size in bytes (env: IBC_LOG_MAX_BYTES).
# Default 10485760 (10 MiB)
# log_max_bytes = 10485760
# log_backup_count: number of rotated backups to keep (env: IBC_LOG_BACKUP_COUNT).
# Default 5
# log_backup_count = 5

# Raw wire trace: every command sent to and event received from the Java agent, written
# as NDJSON to cmd-{instance}.jsonl and events-{instance}.jsonl under log_dir. Always
# file, regardless of log_sink; rotated like the other files. Verbose -- enable for
# troubleshooting. true/false; independent of log_level (env: IBC_TRACE_ENABLED)
# Default false
# trace_enabled = false

# Diagnostics -- off by default. When enabled, logs a component structure dump
# (the same primitive settings.py/recognisers.py use to find controls) for each
# matching window event, to ibcontroller-{instance}.log at INFO. Built-in
# replacement for poking the agent socket directly with socat/nc.
# diagnostic_scope: which windows qualify -- "known" (recognised by a built-in or
# declarative recogniser), "unknown", or "all" (env: IBC_DIAGNOSTIC_SCOPE)
# Default "known"
# diagnostic_scope = "known"
# diagnostic_when: which events trigger a dump -- "open", "openclose", or "never"
# (off) (env: IBC_DIAGNOSTIC_WHEN)
# Default "never"
# diagnostic_when = "open"
# diagnostic_settings_sweep: while the Global Configuration dialog is open, log a dump
# of each tree node in labels.json settings.sweep_paths (read-only; env:
# IBC_DIAGNOSTIC_SETTINGS_SWEEP)
# Default false
# diagnostic_settings_sweep = true

# IBC: ReadOnlyLogin -- TWS only (Gateway logs a warning and logs in normally). Clicks
# "Enter Read Only" on the 2FA frame instead of waiting for the push; no effect without 2FA.
# Default false
# read_only_login = false

# IBC: ExistingSessionDetectedAction -- how ibcontroller itself reacts to Gateway's
# "existing session detected", "Re-login is required" and "Trading Login Handoff" dialogs:
# manual/primary/primaryoverride/secondary (table in docs/Configuration.md)
# (env: IBC_EXISTING_SESSION_ACTION)
# Default "manual"
# existing_session_action = "manual"

# IBC: AcceptIncomingConnectionAction -- how ibcontroller reacts to TWS/Gateway's
# "Accept incoming connection" dialog, shown when an API client connects.
# If set to 'accept', ibcontroller automatically accepts incoming API connection
# dialogs. If set to 'reject', ibcontroller automatically rejects incoming API
# connection dialogs. If set to 'manual', the user must decide whether to accept
# or reject incoming API connection dialogs. The default is 'manual'.
# (env: IBC_ACCEPT_INCOMING_CONNECTIONS)
# accept_incoming_connections = "manual"

# --- Login/2FA timeout and retry settings -- ibcontroller's own policy, not written to
# --- Gateway/TWS itself (though mfa_timeout mirrors IBKR's real 2FA limit).
# IBC: LoginDialogDisplayTimeout, default 60
# login_dialog_display_timeout = 60.0
# IBC: SecondFactorAuthenticationTimeout, default 180. IB's own limit for an unanswered
# 2FA push: a 2FA dialog closing at or after it counts as timed out
# mfa_timeout = 180.0
# IBC: ReloginAfterSecondFactorAuthenticationTimeout, default false. true: log in again
# 5 s after a timed-out push, and enforce mfa_exit_interval after an approved one;
# false: keep waiting for the push
# relogin_after_mfa_timeout = false
# IBC: SecondFactorAuthenticationExitInterval, default 60. With relogin on: seconds to
# wait for login to complete after the push is approved, then mfa_timeout_action applies
# mfa_exit_interval = 60.0
# IBC: --on2fatimeout, default "exit". What to do when mfa_exit_interval expires:
# "exit" (exit code 75) or "restart" (relaunch with a fresh login)
# mfa_timeout_action = "exit"
# Max consecutive relaunches that never reach READY (login frame timeout, transient
# login failure, TWS logout, crash during login), then exit code 70. Default 3
# restart_cap = 3

# --- Applies to TWS and Gateway alike (ported from IBC's IbcTws.java, the shared
# --- base class both programs use). Both are ibcontroller's own scheduled actions,
# --- not GUI settings written to TWS/Gateway -- see control_loop.py. If both are
# --- set, whichever occurs first wins.
# IBC: ColdRestartTime -- "HH:MM", 24-hour, local time. Every Sunday at this time,
# ibcontroller closes the instance tidily and relaunches with a full fresh login
# (via ibcontroller's own launch_instance, not IBC's native-launcher File > Restart),
# forcing the weekly reauth IBKR requires around Sunday 01:00 US/Eastern token
# invalidation (env: IBC_COLD_RESTART_TIME)
# Default None - not set
# cold_restart_time = "07:05"

# IBC: ClosedownAt -- "HH:MM" (every day) or "<Weekday> HH:MM" (one day a week,
# Weekday a full English name, Monday..Sunday). At this time, ibcontroller closes
# the instance tidily with no relaunch -- you're responsible for restarting it
# yourself (env: IBC_CLOSEDOWN_AT)
# Default None - not set
# closedown_at = "22:00"
# closedown_at = "Friday 22:00"

# JVM heap for TWS/Gateway at launch, e.g. "1024m"/"4g". Overrides the -Xmx
# line in the installed .vmoptions file (ibgateway.vmoptions/tws.vmoptions);
# bare size, no -Xmx prefix (env: IBC_JAVA_HEAP_SIZE)
# Default None - leave the installed file's value untouched
# java_heap_size = "2g"

# Set time zone on jts.ini
# time_zone = "America/New_York"

[ibkr]

# --- Global Configuration settings, one line each, written once at startup. A setting
# with no value is left as it is in Gateway/TWS. Values are checked at startup.
# Env: IBKR_<NAME> (e.g. IBKR_READ_ONLY_API=true; true/false/yes/no in any case).

# IBC: AutoLogoffTime. Time of the daily logoff, "hh:mm AM/PM" with one space,
# e.g. "08:00 AM". Shares the Lock and Exit radio pair with auto_restart_time below:
# if you set both, auto_restart_time wins, as in IBC.
# Default: not set
# auto_logoff_time = "08:00 AM"

# IBC: AutoRestartTime. Time of the daily restart, "hh:mm AM/PM" with one space,
# e.g. "08:00 AM".
# Default: not set
# auto_restart_time = "08:00 AM"

# IBC: ReadOnlyApi. API/Settings, "Read-Only API": true or false.
# Default: not set
# read_only_api = true

# IBC: OverrideTwsApiPort. API/Settings "Socket port", a number or text. IBKR's defaults:
# 7496 TWS live, 7497 TWS paper, 4001 Gateway live, 4002 Gateway paper. Changing it on
# TWS opens a confirmation dialog after OK, see socket_port_confirmation below.
# Default: not set
# socket_port = 4002

# IBC: OverrideTwsMasterClientID. API/Settings "Master API client ID", a number or text.
# Default: not set
# master_api_client_id = 0

# IBC: SendMarketDataInLotsForUSstocks. API/Settings, "Send market data in lots for US
# stocks for dual-mode API clients": true or false. Unverified: ticking the box may open
# a confirmation window that ibcontroller does not handle yet.
# Default: not set
# send_market_data_in_lots_us_stocks = false

# API/Precautions, "Bypass ... for API orders": true bypasses the warning, false keeps
# it. IBC: BypassOrderPrecautions, BypassBondWarning, BypassNegativeYieldToWorstConfirmation,
# BypassCalledBondWarning, BypassSameActionPairTradeWarning, BypassPriceBasedVolatilityWarning,
# BypassRedirectOrderWarning, BypassNoOverfillProtection, BypassRouteMarketableToBBOWarning.
# Default: not set
# api_precautions_bypass_order_precautions = true
# api_precautions_bypass_bond_warning = true
# api_precautions_bypass_negative_yield_to_worst = true
# api_precautions_bypass_called_bond_warning = true
# api_precautions_bypass_same_action_pair_trade = true
# api_precautions_bypass_price_based_volatility = true
# api_precautions_bypass_redirect_order_warning = true
# api_precautions_bypass_no_overfill_protection = true
# api_precautions_bypass_route_marketable_to_bbo = true

# --- Pop-ups ibcontroller handles, one line each. A dialog takes the name of one of its
# modes, or true (mode "on") / false (mode "off"). In the environment, true/false/yes/no
# in any case count as booleans (env: IBKR_<NAME>, e.g. IBKR_BLIND_TRADING=true).
# A mode with no steps ("off") leaves the dialog for you to answer.

# "This is not a brokerage account" warning: clicks "I understand and accept"
# Modes "off", "on". Default "on"
# non_brokerage_account = "on"

# Confirmation shown after Gateway/TWS is set to restart automatically: clicks "OK"
# Modes "off", "on". Default "on"
# auto_restart_confirmation = "on"

# Password expiry notice (title "Password Notice"): clicks "OK". Unverified, the text
# comes from IBC's source and was not seen on a live window.
# Modes "off", "on". Default "off"
# password_expiry_warning = "off"

# Blind trading warning on an order for a product without market data: clicks
# "Override and Transmit" or "Yes". Unverified, as above.
# Modes "off", "on". Default "off"
# blind_trading = "off"

# TWS only: "Press YES if you wish to apply the new socket port setting immediately",
# shown after OK when socket_port changed. "on" clicks "Yes" (the port takes effect at
# once), "no" clicks "No" (it takes effect when the GUI restarts), "off" leaves it to you.
# Modes "off", "on", "no". Default "off"
# socket_port_confirmation = "off"

# A Global Configuration setting the catalog lacks. It carries no value: give it one
# in [ibkr] under its name, or as IBKR_<NAME>. A custom name must not be a catalog name,
# nor the name of a dialog. tree_path: the section of the Global Configuration tree.
# action: "toggle" (checkbox, value true/false), "type_text" (field with a label, value
# text or number), "type_text_near_label" (field with no name of its own, found by
# position below the label; field_index counts from 0, default 0). The control is named
# with label (literal text) or label_ref (an entry of labels.json settings.controls).
# [[setting]]
# name = "my_checkbox_setting"
# tree_path = "API/Settings"
# action = "toggle"
# label = "Label of the checkbox"

# A pop-up the catalog lacks. A custom entry is checked before catalog ones and needs a
# name that no catalog entry uses. match: a list of groups, any one is enough; inside a
# group every field must match, ignoring case. Fields: title, text, text_also.
# modes: each mode is a list of steps, run in order on the window. A step is
# { click = "OK" } or { click = ["OK", "Yes"] }, the first button found is clicked.
# default: the mode used when [ibkr] gives no value. The entry's name also works as a
# key in [ibkr] and as IBKR_<NAME>.
# [[dialog]]
# name = "my_custom_warning"
# default = "on"
# match = [ { title = "Warning", text = "some phrase" }, { text = "another phrase" } ]
# [dialog.modes]
# off = []
# on = [ { click = ["OK", "Yes"] } ]
