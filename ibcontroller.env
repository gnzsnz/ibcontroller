###############################################################################
#########
#########   IBController settings
#########
###############################################################################

# defaults to "{program}-{trading_mode}" (e.g. "gateway-paper")
# IBCONTROLLER_INSTANCE=
# "gateway" or "tws"
# IBCONTROLLER_PROGRAM=gateway
# Default, auto-detect. ie 10.50
# IBCONTROLLER_TWS_VERSION=
# "stable"/"latest", default to "stable"
# IBCONTROLLER_TWS_CHANNEL=stable
# Default search on default install path, ~/Jts
# IBCONTROLLER_TWS_PATH=
# Default, TWS_PATH/INSTANCE, ie ~/Jts/gateway-stable
# IBCONTROLLER_TWS_SETTINGS_PATH=
# Declarative settings file,
# IBCONTROLLER_SETTINGS_FILE=
# Custom defined base dir for config/log/run. Default platform defaults
# IBCONTROLLER_APP_DIR=

###############################################################################
#########
#########   Credentials -- mandatory, env-only, never in ibcontroller.toml
#########
###############################################################################

# TWS/IBKR Gateway login. No default, required.
# IBCONTROLLER_USERID=
# IBCONTROLLER_PASSWORD=
# Docker-secrets pattern: point at a file instead, wins over the plain var if set
# IBCONTROLLER_USERID_FILE=
# IBCONTROLLER_PASSWORD_FILE=

###############################################################################
#########
#########   TWS/gateway settings
#########
###############################################################################

# "live" or "paper", default paper
# IBCONTROLLER_TRADING_MODE=paper
# IBC: ReadOnlyLogin. true/false, default false
# IBCONTROLLER_READ_ONLY_LOGIN=false
# IBKR API read-only mode. true/false, default unset (leave existing setting unchanged)
# IBCONTROLLER_READ_ONLY_API=
# "accept"/"reject"/"manual", default manual
# IBCONTROLLER_ACCEPT_INCOMING_CONNECTIONS=manual
# "manual"/"primary"/"primaryoverride"/"secondary", default manual
# IBCONTROLLER_EXISTING_SESSION_ACTION=manual
# AutoRestartTime "hh:mm AM/PM" ie "08:00 AM", default unset (leave existing setting unchanged)
# IBCONTROLLER_AUTO_RESTART_TIME=
# AutoLogoffTime "hh:mm AM/PM" ie "08:00 AM", default unset (leave existing setting unchanged).
# Shares one Lock and Exit radio-button pair with AUTO_RESTART_TIME -- if both set,
# this one wins (applied last)
# IBCONTROLLER_AUTO_LOGOFF_TIME=
# JVM heap for TWS/Gateway at launch, ie "1024m"/"4g". Default unset (leave the
# installed .vmoptions file's -Xmx value untouched)
# IBCONTROLLER_JAVA_HEAP_SIZE=

###############################################################################
#########
#########   Login/2FA timeout and retry settings
#########
###############################################################################

# IBC: LoginDialogDisplayTimeout, seconds. Default 60
# IBCONTROLLER_LOGIN_DIALOG_DISPLAY_TIMEOUT=60
# IBC: SecondFactorAuthenticationTimeout, seconds. Default 180
# IBCONTROLLER_SECOND_FACTOR_AUTHENTICATION_TIMEOUT=180
# IBC: ReloginAfterSecondFactorAuthenticationTimeout. true/false, default false
# IBCONTROLLER_RELOGIN_AFTER_2FA_TIMEOUT=false
# IBC: SecondFactorAuthenticationExitInterval, seconds. Default 60
# IBCONTROLLER_SECOND_FACTOR_AUTHENTICATION_EXIT_INTERVAL=60

###############################################################################
#########
#########   Self-scheduled shutdown actions (ibcontroller-side, not GUI settings)
#########
###############################################################################

# ColdRestartTime "HH:MM" 24-hour local time, every Sunday: close tidily and
# relaunch with a full fresh login (weekly reauth). Default unset (disabled)
# IBCONTROLLER_COLD_RESTART_TIME=
# ClosedownAt "HH:MM" (daily) or "<Weekday> HH:MM" (weekly): close tidily, no
# relaunch. If both COLD_RESTART_TIME and CLOSEDOWN_AT are set, whichever occurs
# first wins. Default unset (disabled)
# IBCONTROLLER_CLOSEDOWN_AT=

###############################################################################
#########
#########   IBController logging settings
#########
###############################################################################

# Enable raw wire trace, true/false. Default false
# IBCONTROLLER_TRACE_ENABLED=
# Default, platform log dir (see app_dirs.py)
# IBCONTROLLER_LOG_DIR=
# debug/info/warning/error, Default info
# IBCONTROLLER_LOG_LEVEL=
# std/file, default std
# IBCONTROLLER_LOG_SINK=
# "known"/"unknown"/"all", default "known"
# IBCONTROLLER_DIAGNOSTIC_SCOPE=
# "open"/"openclose"/"never", default "never"
# IBCONTROLLER_DIAGNOSTIC_WHEN=

###############################################################################
